{
  "name": "smartlearnpro",
  "private": true,
  "version": "0.1.8",
  "description": "AI English Learning Assistant",
  "author": "User <user@example.com>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -r https://github.com/wysbmm-cy/smart-learn-pro.git",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wysbmm-cy/smart-learn-pro.git"
  },
  "build": {
    "appId": "com.smartlearnpro.app",
    "productName": "SmartLearn Pro",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "dir",
      "icon": "public/icon.png"
    }
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "clsx": "^2.1.1",
    "electron-updater": "^6.7.3",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.358.0",
    "pdfjs-dist": "^5.4.449",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-force-graph-2d": "^1.29.0",
    "react-force-graph-3d": "^1.29.0",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.0.15",
    "react-window": "^2.2.3",
    "recharts": "^3.6.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "ts-fsrs": "^5.2.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "7zip-bin": "^5.2.0",
    "app-builder-bin": "^5.0.0-alpha.12",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.6",
    "wait-on": "^9.0.3"
  }
}
