# Copy this file to the project root as ".env" on the server.
PORT=3001
NODE_ENV=production

# Comma-separated browser origins allowed to call this backend.
# Add your GitHub Pages and Vercel origins here.
CLIENT_ORIGIN=https://wysbmm-cy.github.io,https://smart-learn-pro.vercel.app,http://localhost:5173

# Optional. If set, clients must send this value in X-VerbaPath-Proxy-Token.
# Keep it different from your real model API keys.
PROXY_ACCESS_TOKEN=
PROXY_RATE_LIMIT_WINDOW_MS=900000
# Free-user protection: 40 proxy calls per IP per 15 minutes by default.
PROXY_RATE_LIMIT_MAX=40

AI_PROXY_BASE_URL=https://api.deepseek.com/v1
AI_PROXY_API_KEY=
AI_PROXY_MODEL=deepseek-v4-flash

AUDIO_PROXY_BASE_URL=https://api.siliconflow.cn/v1
AUDIO_PROXY_API_KEY=

TTS_PROXY_BASE_URL=https://openrouter.ai/api/v1
TTS_PROXY_API_KEY=

IMAGE_PROXY_BASE_URL=https://api.deepseek.com/v1
IMAGE_PROXY_API_KEY=
IMAGE_PROXY_MODEL=dall-e-3
